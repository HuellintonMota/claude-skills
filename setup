#!/usr/bin/env bash
# Liga as skills escolhidas de skills/ nos agentes escolhidos, como links para este checkout.
#
# Uso: ./setup                  pergunta em quais agentes e quais skills instalar
#      ./setup --todas          instala todas, sem perguntar
#      ./setup --skills a,b     instala só essas, sem perguntar
#      ./setup --atualizar      religa as que já estão instaladas e só lista as novas (usado pela
#                               skill claude-skills-atualizar, que roda sem terminal interativo)
#      --agente a,b             em quais agentes instalar (também --host): claude, codex, gemini,
#                               antigravity, cursor, opencode, copilot, kiro, factory, ou auto (todos
#                               os detectados). Sem a opção: onde já estão instaladas; na primeira
#                               vez, só o Claude Code
#      --agentes                lista os agentes, onde cada um guarda skills e quais foram detectados
#      --versao                 mostra a versão das claude-skills deste checkout
#      --sim                    instala dependências do sistema que faltarem sem perguntar
#      --sem-dependencias       não confere dependências
#      --auto-atualizar         liga a atualização automática (uma vez por dia, ao abrir o Claude Code)
#      --sem-auto-atualizar     desliga a atualização automática
#
# Cada skill pode ter um dependencias.sh: confere o que ela precisa, instala sozinho o que fica dentro
# da pasta da skill (ex.: .venv) e pergunta antes de instalar programas no sistema.
#
# No terminal, a escolha é por caixas de seleção (↑/↓ ou k/j, Espaço, a, Enter, q ou Esc). Sem suporte
# a isso (TERM=dumb) ou com CLAUDE_SKILLS_SEM_MENU=1, a escolha é por números.
#
# Testes: CLAUDE_SKILLS_DIR troca a pasta do Claude Code e CLAUDE_SKILLS_HOME troca a pasta pessoal
# usada para os outros agentes (padrão: $HOME).
set -e

# Sempre instalada, sem aparecer na escolha: é por ela que as outras se atualizam.
SEMPRE="claude-skills-atualizar"

RAIZ="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
BASE="${CLAUDE_SKILLS_HOME:-$HOME}"
VERSAO="$(head -1 "$RAIZ/VERSION" 2>/dev/null | tr -d '\r ')"
VERSAO="${VERSAO:-?}"
# shellcheck source=lib/menu.sh
. "$RAIZ/lib/menu.sh"

windows=false
case "${OSTYPE:-}" in msys*|cygwin*) windows=true ;; esac

# Agentes na ordem em que são instalados: quem só lê a pasta de outro agente vem depois dele.
AGENTES="claude codex gemini antigravity kiro factory cursor opencode copilot"

agente_nome() {
  case "$1" in
    claude) echo "Claude Code" ;;
    codex) echo "Codex CLI" ;;
    gemini) echo "Gemini CLI" ;;
    antigravity) echo "Antigravity" ;;
    kiro) echo "Kiro" ;;
    factory) echo "Factory Droid" ;;
    cursor) echo "Cursor" ;;
    opencode) echo "OpenCode" ;;
    copilot) echo "GitHub Copilot CLI" ;;
  esac
}

# Pasta de skills pessoais de cada agente, como está na documentação dele (links no README).
# Codex e Gemini CLI dividem ~/.agents/skills: é a pasta do Codex e um apelido documentado do Gemini.
agente_destino() {
  case "$1" in
    claude) echo "${CLAUDE_SKILLS_DIR:-$HOME/.claude/skills}" ;;
    codex|gemini) echo "$BASE/.agents/skills" ;;
    antigravity) echo "$BASE/.gemini/config/skills" ;;
    kiro) echo "$BASE/.kiro/skills" ;;
    factory) echo "$BASE/.factory/skills" ;;
    cursor) echo "$BASE/.cursor/skills" ;;
    opencode) echo "$BASE/.config/opencode/skills" ;;
    copilot) echo "$BASE/.copilot/skills" ;;
  esac
}

# Agentes que também leem as pastas do Claude Code e de ~/.agents/skills. Com as skills já ligadas
# numa delas, um link próprio faria cada skill aparecer duas vezes.
agente_tambem_le() {
  case "$1" in
    cursor|opencode|copilot) echo "claude codex gemini" ;;
  esac
}

agente_detectado() {
  case "$1" in
    claude) command -v claude >/dev/null 2>&1 || [ -d "$HOME/.claude" ] ;;
    codex) command -v codex >/dev/null 2>&1 || [ -d "$BASE/.codex" ] ;;
    gemini) command -v gemini >/dev/null 2>&1 || [ -f "$BASE/.gemini/settings.json" ] ;;
    antigravity)
      command -v agy >/dev/null 2>&1 || command -v antigravity >/dev/null 2>&1 \
        || [ -d "$BASE/.gemini/antigravity" ] || [ -d "$BASE/.gemini/antigravity-cli" ] \
        || [ -d "$BASE/.gemini/config" ] || { [ -n "${LOCALAPPDATA:-}" ] && [ -d "$LOCALAPPDATA/Programs/Antigravity" ]; } ;;
    kiro) command -v kiro-cli >/dev/null 2>&1 || command -v kiro >/dev/null 2>&1 || [ -d "$BASE/.kiro" ] ;;
    factory) command -v droid >/dev/null 2>&1 || [ -d "$BASE/.factory" ] ;;
    cursor) command -v cursor >/dev/null 2>&1 || [ -d "$BASE/.cursor" ] ;;
    opencode) command -v opencode >/dev/null 2>&1 || [ -d "$BASE/.config/opencode" ] ;;
    copilot) command -v copilot >/dev/null 2>&1 || [ -d "$BASE/.copilot" ] ;;
    *) return 1 ;;
  esac
}

normalizar_agente() {
  case "$1" in
    claude|claude-code) echo claude ;;
    codex|codex-cli) echo codex ;;
    gemini|gemini-cli) echo gemini ;;
    antigravity|agy) echo antigravity ;;
    kiro|kiro-cli) echo kiro ;;
    factory|droid) echo factory ;;
    cursor) echo cursor ;;
    opencode) echo opencode ;;
    copilot|copilot-cli) echo copilot ;;
    *) return 1 ;;
  esac
}

curto() { case "$1" in "$HOME"/*) echo "~${1#"$HOME"}" ;; *) echo "$1" ;; esac; }

contem() { case " $1 " in *" $2 "*) return 0 ;; *) return 1 ;; esac; }

modo=perguntar
pedidas=""
pedidos_agentes=""
dependencias=true
DEP_MODO=perguntar
auto=""
listar_agentes=false
while [ $# -gt 0 ]; do
  case "$1" in
    --todas) modo=todas ;;
    --skills) modo=lista; pedidas="$2"; shift ;;
    --atualizar) modo=atualizar ;;
    --agente|--host) pedidos_agentes="$2"; shift ;;
    --agente=*|--host=*) pedidos_agentes="${1#*=}" ;;
    --agentes) listar_agentes=true ;;
    --versao) echo "$VERSAO"; exit 0 ;;
    --sim) DEP_MODO=sim ;;
    --sem-dependencias) dependencias=false ;;
    --auto-atualizar) auto=ligar ;;
    --sem-auto-atualizar) auto=desligar ;;
    -h|--help) sed -n '2,27p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) echo "Opção desconhecida: $1" >&2; exit 1 ;;
  esac
  shift
done

nomes=()
for pasta in "$RAIZ"/skills/*/; do
  nome="$(basename "$pasta")"
  [ -f "$pasta/SKILL.md" ] && [ "$nome" != "$SEMPRE" ] && nomes+=("$nome")
done

descricao() {
  awk '
    /^description:/ { sub(/^description: */, ""); if ($0 !~ /^[>|]-?$/ && $0 != "") { print; exit } dobrada = 1; next }
    dobrada && /^  / { sub(/^ +/, ""); print; exit }
  ' "$RAIZ/skills/$1/SKILL.md" | cut -c1-90
}

ligada_em() {
  local link="$1/$2"
  [ -L "$link" ] && [ "$(cd "$link" 2>/dev/null && pwd -P)" = "$(cd "$RAIZ/skills/$2" && pwd -P)" ]
}

instalado_em() { ligada_em "$(agente_destino "$1")" "$SEMPRE"; }

if $listar_agentes; then
  for a in $AGENTES; do
    estado="não detectado"; agente_detectado "$a" && estado="detectado"
    if instalado_em "$a"; then estado="$estado, com as claude-skills"; fi
    printf "  %-12s %-20s %-30s %s\n" "$a" "$(agente_nome "$a")" "$(curto "$(agente_destino "$a")")" "$estado"
  done
  exit 0
fi

instalados=""
for a in $AGENTES; do if instalado_em "$a"; then instalados="$instalados $a"; fi; done
padrao="${instalados:- claude}"

agentes=""
if [ -n "$pedidos_agentes" ]; then
  IFS=',' read -r -a lista <<< "$pedidos_agentes"
  for p in "${lista[@]}"; do
    p="$(echo "$p" | tr -d ' ' | tr '[:upper:]' '[:lower:]')"
    [ -z "$p" ] && continue
    if [ "$p" = auto ]; then
      for a in $AGENTES; do if agente_detectado "$a"; then agentes="$agentes $a"; fi; done
      [ -z "$agentes" ] && agentes=" claude"
    elif a="$(normalizar_agente "$p")"; then
      agentes="$agentes $a"
    else
      echo "Agente desconhecido: $p. Use um destes: $AGENTES, ou auto." >&2
      exit 1
    fi
  done
elif [ "$modo" = perguntar ] && [ -t 0 ]; then
  oferecidos=""
  for a in $AGENTES; do
    if [ "$a" = claude ] || agente_detectado "$a" || contem "$padrao" "$a"; then oferecidos="$oferecidos $a"; fi
  done
  if [ "$oferecidos" = " claude" ]; then
    agentes="$padrao"
  elif menu_suportado; then
    MENU_ROTULOS=(); MENU_DESCRICOES=(); MENU_MARCADOS=(); ofertas=()
    for a in $oferecidos; do
      ofertas+=("$a")
      MENU_ROTULOS+=("$(agente_nome "$a")")
      MENU_DESCRICOES+=("$(curto "$(agente_destino "$a")")")
      if contem "$padrao" "$a"; then MENU_MARCADOS+=(1); else MENU_MARCADOS+=(0); fi
    done
    if ! menu_escolher "Em quais agentes instalar?"; then
      echo "Cancelado: nada foi instalado."
      exit 0
    fi
    for i in "${!ofertas[@]}"; do
      if [ "${MENU_MARCADOS[$i]}" = 1 ]; then agentes="$agentes ${ofertas[$i]}"; fi
    done
    if [ -z "$agentes" ]; then
      echo "Nenhum agente marcado: nada foi instalado."
      exit 0
    fi
  else
    echo "Agentes encontrados nesta máquina:"
    i=0; ofertas=()
    for a in $oferecidos; do
      i=$((i + 1)); ofertas+=("$a")
      marca=" "; contem "$padrao" "$a" && marca="x"
      printf "  %d) [%s] %-20s %s\n" "$i" "$marca" "$(agente_nome "$a")" "$(curto "$(agente_destino "$a")")"
    done
    read -r -p "Em quais instalar? Números separados por espaço, ou Enter para os marcados: " resposta
    if [ -z "$resposta" ]; then
      agentes="$padrao"
    else
      for k in $resposta; do
        if [[ "$k" =~ ^[0-9]+$ ]] && [ "$k" -ge 1 ] && [ "$k" -le ${#ofertas[@]} ]; then
          agentes="$agentes ${ofertas[$((k - 1))]}"
        else
          echo "  ignorei \"$k\": não está na lista"
        fi
      done
      [ -z "$agentes" ] && agentes="$padrao"
    fi
  fi
else
  agentes="$padrao"
fi

# Ordena, tira repetidos e separa quem já lê a pasta de outro agente escolhido ou instalado.
ordenados=""
for a in $AGENTES; do if contem "$agentes" "$a"; then ordenados="$ordenados $a"; fi; done
agentes=""; lidos_por=""
for a in $ordenados; do
  fonte=""
  for b in $(agente_tambem_le "$a"); do
    if contem "$agentes" "$b" || instalado_em "$b"; then fonte="$b"; break; fi
  done
  if [ -n "$fonte" ] && ! instalado_em "$a"; then
    lidos_por="$lidos_por $a:$fonte"
  else
    agentes="$agentes $a"
  fi
done

destinos=""
for a in $agentes; do
  d="$(agente_destino "$a")"
  contem "$destinos" "$d" || destinos="$destinos $d"
done

ligada_algum() {
  local d
  for d in $destinos; do ligada_em "$d" "$1" && return 0; done
  return 1
}

nomes_do_destino() {
  local a lista=""
  for a in $agentes; do [ "$(agente_destino "$a")" = "$1" ] && lista="$lista, $(agente_nome "$a")"; done
  echo "${lista#, }"
}

ligar() {
  local destino="$1" nome="$2" link="$1/$2"
  if [ -L "$link" ]; then
    rm -f "$link"
  elif [ -e "$link" ]; then
    echo "  pulei $nome: já existe em $(curto "$destino") e não veio daqui (mova ou apague e rode de novo)"
    return
  fi
  if $windows; then
    # Junction não exige modo de desenvolvedor nem administrador, ao contrário do symlink do Windows.
    powershell -NoProfile -Command "New-Item -ItemType Junction -Path '$(cygpath -w "$link")' -Target '$(cygpath -w "$RAIZ/skills/$nome")' | Out-Null"
  else
    ln -s "$RAIZ/skills/$nome" "$link"
  fi
  echo "  $nome"
}

escolhidas=()
novas=()
case "$modo" in
  todas) escolhidas=("${nomes[@]}") ;;
  lista) IFS=',' read -r -a escolhidas <<< "$pedidas" ;;
  atualizar)
    for n in "${nomes[@]}"; do
      if ligada_algum "$n"; then escolhidas+=("$n"); else novas+=("$n"); fi
    done
    ;;
  perguntar)
    if [ ! -t 0 ]; then
      echo "Sem terminal interativo: use --todas ou --skills a,b." >&2
      exit 1
    fi
    if menu_suportado; then
      # Vêm marcadas as já instaladas; na primeira vez, todas, como o Enter do modo numérico.
      MENU_ROTULOS=(); MENU_DESCRICOES=(); MENU_MARCADOS=(); alguma=false
      for n in "${nomes[@]}"; do if ligada_algum "$n"; then alguma=true; fi; done
      for n in "${nomes[@]}"; do
        MENU_ROTULOS+=("$n")
        MENU_DESCRICOES+=("$(descricao "$n")")
        if ! $alguma || ligada_algum "$n"; then MENU_MARCADOS+=(1); else MENU_MARCADOS+=(0); fi
      done
      if ! menu_escolher "Quais skills instalar? (a $SEMPRE vai sempre)"; then
        echo "Cancelado: nada foi instalado."
        exit 0
      fi
      for i in "${!nomes[@]}"; do
        if [ "${MENU_MARCADOS[$i]}" = 1 ]; then escolhidas+=("${nomes[$i]}"); fi
      done
    else
      echo "Skills disponíveis:"
      for i in "${!nomes[@]}"; do
        marca=" "; ligada_algum "${nomes[$i]}" && marca="*"
        printf "  %d) [%s] %-26s %s\n" $((i + 1)) "$marca" "${nomes[$i]}" "$(descricao "${nomes[$i]}")"
      done
      echo "  [*] = já instalada"
      read -r -p "Quais instalar? Números separados por espaço, ou Enter para todas: " resposta
      if [ -z "$resposta" ]; then
        escolhidas=("${nomes[@]}")
      else
        for k in $resposta; do
          if [[ "$k" =~ ^[0-9]+$ ]] && [ "$k" -ge 1 ] && [ "$k" -le ${#nomes[@]} ]; then
            escolhidas+=("${nomes[$((k - 1))]}")
          else
            echo "  ignorei \"$k\": não está na lista"
          fi
        done
      fi
    fi
    ;;
esac

for d in $destinos; do
  mkdir -p "$d"
  echo "Skills em $(curto "$d") ($(nomes_do_destino "$d")):"
  ligar "$d" "$SEMPRE"
  for n in "${escolhidas[@]}"; do
    [ "$n" = "$SEMPRE" ] && continue
    # No --atualizar, cada pasta religa só as skills que já tinha.
    if [ "$modo" = atualizar ] && ! ligada_em "$d" "$n"; then continue; fi
    if [ -f "$RAIZ/skills/$n/SKILL.md" ]; then ligar "$d" "$n"; else echo "  não existe skill \"$n\""; fi
  done
done
for par in $lidos_por; do
  a="${par%%:*}"; b="${par#*:}"
  echo "$(agente_nome "$a"): já lê $(curto "$(agente_destino "$b")") ($(agente_nome "$b")); não precisa de link próprio."
done

if [ "$modo" != atualizar ]; then
  for n in "${escolhidas[@]}"; do
    if [ -f "$RAIZ/skills/$n/configurar.sh" ] && ligada_algum "$n"; then bash "$RAIZ/skills/$n/configurar.sh"; fi
  done
fi

if $dependencias; then
  [ -t 0 ] || [ "$DEP_MODO" = sim ] || DEP_MODO=nao
  # shellcheck source=lib/dependencias.sh
  . "$RAIZ/lib/dependencias.sh"
  echo "Dependências:"
  for n in "$SEMPRE" "${escolhidas[@]}"; do
    script="$RAIZ/skills/$n/dependencias.sh"
    [ -f "$script" ] && ligada_algum "$n" || continue
    echo "  $n"
    SKILL_DIR="$RAIZ/skills/$n"
    . "$script"
  done
  if [ "$DEP_PENDENTES" -gt 0 ]; then
    echo "Faltam $DEP_PENDENTES dependência(s) (✗ acima). Resolva e rode o setup de novo para conferir."
  else
    echo "  tudo certo"
  fi
fi

# A atualização automática é um hook SessionStart no settings.json do Claude Code; quem edita o JSON é
# um script Python, para não reescrever à mão um arquivo que tem outras configurações da pessoa.
SETTINGS="${CLAUDE_CONFIG_DIR:-$HOME/.claude}/settings.json"
HOOK="bash \"$RAIZ/lib/auto-atualizar.sh\""
python_ok=""
for p in python3 python py; do
  if command -v "$p" >/dev/null 2>&1 && "$p" -c "import json" >/dev/null 2>&1; then python_ok="$p"; break; fi
done
registrar() { "$python_ok" "$RAIZ/lib/registrar_hook.py" "$1" "$SETTINGS" "$HOOK"; }
if [ -z "$auto" ] && [ "$modo" = perguntar ] && contem "$agentes" claude && [ -n "$python_ok" ] \
  && [ "$(registrar estado)" = desligado ]; then
  read -r -p "Atualizar as skills sozinho, uma vez por dia, ao abrir o Claude Code? [S/n] " r
  case "$r" in n|N|nao|não) ;; *) auto=ligar ;; esac
fi
if [ "$auto" = ligar ] && ! contem "$agentes" claude; then
  echo "Atualização automática: é um hook do Claude Code, que não está entre os agentes. Nos outros, atualize com"
  echo "  git -C \"$RAIZ\" pull --ff-only && bash \"$RAIZ/setup\" --atualizar"
elif [ -n "$auto" ]; then
  if [ -z "$python_ok" ]; then
    echo "Atualização automática: precisa de Python para editar $SETTINGS. Sem ele, adicione à mão um hook"
    echo "  SessionStart com o comando: $HOOK"
  else
    echo "Atualização automática: $(registrar "$auto") ($SETTINGS)"
  fi
fi

if [ "$modo" = atualizar ] && [ ${#novas[@]} -gt 0 ]; then
  echo "Não instaladas (para instalar: bash $RAIZ/setup --skills <nome>):"
  for n in "${novas[@]}"; do echo "  $n — $(descricao "$n")"; done
fi
abrir=""
for a in $agentes; do abrir="$abrir, $(agente_nome "$a")"; done
for par in $lidos_por; do abrir="$abrir, $(agente_nome "${par%%:*}")"; done
echo "Pronto: claude-skills $VERSAO. Abra uma sessão nova (${abrir#, }) para carregar as skills."
