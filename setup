#!/usr/bin/env bash
# Liga no Claude Code as skills escolhidas de skills/, como links para este checkout.
#
# Uso: ./setup                  pergunta quais skills instalar
#      ./setup --todas          instala todas, sem perguntar
#      ./setup --skills a,b     instala só essas, sem perguntar
#      ./setup --atualizar      religa as que já estão instaladas e só lista as novas (usado pela
#                               skill claude-skills-atualizar, que roda sem terminal interativo)
#      --sim                    instala dependências do sistema que faltarem sem perguntar
#      --sem-dependencias       não confere dependências
#      --auto-atualizar         liga a atualização automática (uma vez por dia, ao abrir o Claude Code)
#      --sem-auto-atualizar     desliga a atualização automática
#
# Cada skill pode ter um dependencias.sh: confere o que ela precisa, instala sozinho o que fica dentro
# da pasta da skill (ex.: .venv) e pergunta antes de instalar programas no sistema.
set -e

# Sempre instalada, sem aparecer na escolha: é por ela que as outras se atualizam.
SEMPRE="claude-skills-atualizar"

RAIZ="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
DESTINO="${CLAUDE_SKILLS_DIR:-$HOME/.claude/skills}"
mkdir -p "$DESTINO"

windows=false
case "${OSTYPE:-}" in msys*|cygwin*) windows=true ;; esac

modo=perguntar
pedidas=""
dependencias=true
DEP_MODO=perguntar
auto=""
while [ $# -gt 0 ]; do
  case "$1" in
    --todas) modo=todas ;;
    --skills) modo=lista; pedidas="$2"; shift ;;
    --atualizar) modo=atualizar ;;
    --sim) DEP_MODO=sim ;;
    --sem-dependencias) dependencias=false ;;
    --auto-atualizar) auto=ligar ;;
    --sem-auto-atualizar) auto=desligar ;;
    -h|--help) sed -n '2,15p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) echo "Opção desconhecida: $1" >&2; exit 1 ;;
  esac
  shift
done

nomes=()
for pasta in "$RAIZ"/skills/*/; do
  nome="$(basename "$pasta")"
  [ -f "$pasta/SKILL.md" ] && [ "$nome" != "$SEMPRE" ] && nomes+=("$nome")
done

descricao() {
  awk '
    /^description:/ { sub(/^description: */, ""); if ($0 !~ /^[>|]-?$/ && $0 != "") { print; exit } dobrada = 1; next }
    dobrada && /^  / { sub(/^ +/, ""); print; exit }
  ' "$RAIZ/skills/$1/SKILL.md" | cut -c1-90
}

ligada_aqui() {
  local link="$DESTINO/$1"
  [ -L "$link" ] && [ "$(cd "$link" 2>/dev/null && pwd -P)" = "$(cd "$RAIZ/skills/$1" && pwd -P)" ]
}

ligar() {
  local nome="$1" link="$DESTINO/$1"
  if [ -L "$link" ]; then
    rm -f "$link"
  elif [ -e "$link" ]; then
    echo "  pulei $nome: já existe em $DESTINO e não veio daqui (mova ou apague e rode de novo)"
    return
  fi
  if $windows; then
    # Junction não exige modo de desenvolvedor nem administrador, ao contrário do symlink do Windows.
    powershell -NoProfile -Command "New-Item -ItemType Junction -Path '$(cygpath -w "$link")' -Target '$(cygpath -w "$RAIZ/skills/$nome")' | Out-Null"
  else
    ln -s "$RAIZ/skills/$nome" "$link"
  fi
  echo "  $nome"
  if [ -f "$RAIZ/skills/$nome/configurar.sh" ] && [ "$modo" != atualizar ]; then
    bash "$RAIZ/skills/$nome/configurar.sh"
  fi
}

escolhidas=()
case "$modo" in
  todas) escolhidas=("${nomes[@]}") ;;
  lista) IFS=',' read -r -a escolhidas <<< "$pedidas" ;;
  atualizar)
    novas=()
    for n in "${nomes[@]}"; do
      if ligada_aqui "$n"; then escolhidas+=("$n"); else novas+=("$n"); fi
    done
    ;;
  perguntar)
    if [ ! -t 0 ]; then
      echo "Sem terminal interativo: use --todas ou --skills a,b." >&2
      exit 1
    fi
    echo "Skills disponíveis:"
    for i in "${!nomes[@]}"; do
      marca=" "; ligada_aqui "${nomes[$i]}" && marca="*"
      printf "  %d) [%s] %-26s %s\n" $((i + 1)) "$marca" "${nomes[$i]}" "$(descricao "${nomes[$i]}")"
    done
    echo "  [*] = já instalada"
    read -r -p "Quais instalar? Números separados por espaço, ou Enter para todas: " resposta
    if [ -z "$resposta" ]; then
      escolhidas=("${nomes[@]}")
    else
      for k in $resposta; do
        if [[ "$k" =~ ^[0-9]+$ ]] && [ "$k" -ge 1 ] && [ "$k" -le ${#nomes[@]} ]; then
          escolhidas+=("${nomes[$((k - 1))]}")
        else
          echo "  ignorei \"$k\": não está na lista"
        fi
      done
    fi
    ;;
esac

echo "Skills em $DESTINO:"
ligar "$SEMPRE"
for n in "${escolhidas[@]}"; do
  [ "$n" = "$SEMPRE" ] && continue
  if [ -f "$RAIZ/skills/$n/SKILL.md" ]; then ligar "$n"; else echo "  não existe skill \"$n\""; fi
done
if $dependencias; then
  [ -t 0 ] || [ "$DEP_MODO" = sim ] || DEP_MODO=nao
  # shellcheck source=lib/dependencias.sh
  . "$RAIZ/lib/dependencias.sh"
  echo "Dependências:"
  for n in "$SEMPRE" "${escolhidas[@]}"; do
    script="$RAIZ/skills/$n/dependencias.sh"
    [ -f "$script" ] && ligada_aqui "$n" || continue
    echo "  $n"
    SKILL_DIR="$RAIZ/skills/$n"
    . "$script"
  done
  if [ "$DEP_PENDENTES" -gt 0 ]; then
    echo "Faltam $DEP_PENDENTES dependência(s) (✗ acima). Resolva e rode o setup de novo para conferir."
  else
    echo "  tudo certo"
  fi
fi
# A atualização automática é um hook SessionStart no settings.json do Claude Code; quem edita o JSON é
# um script Python, para não reescrever à mão um arquivo que tem outras configurações da pessoa.
SETTINGS="${CLAUDE_CONFIG_DIR:-$HOME/.claude}/settings.json"
HOOK="bash \"$RAIZ/lib/auto-atualizar.sh\""
python_ok=""
for p in python3 python py; do
  if command -v "$p" >/dev/null 2>&1 && "$p" -c "import json" >/dev/null 2>&1; then python_ok="$p"; break; fi
done
registrar() { "$python_ok" "$RAIZ/lib/registrar_hook.py" "$1" "$SETTINGS" "$HOOK"; }
if [ -z "$auto" ] && [ "$modo" = perguntar ] && [ -n "$python_ok" ] && [ "$(registrar estado)" = desligado ]; then
  read -r -p "Atualizar as skills sozinho, uma vez por dia, ao abrir o Claude Code? [S/n] " r
  case "$r" in n|N|nao|não) ;; *) auto=ligar ;; esac
fi
if [ -n "$auto" ]; then
  if [ -z "$python_ok" ]; then
    echo "Atualização automática: precisa de Python para editar $SETTINGS. Sem ele, adicione à mão um hook"
    echo "  SessionStart com o comando: $HOOK"
  else
    echo "Atualização automática: $(registrar "$auto") ($SETTINGS)"
  fi
fi
if [ "$modo" = atualizar ] && [ ${#novas[@]} -gt 0 ]; then
  echo "Não instaladas (para instalar: bash $RAIZ/setup --skills <nome>):"
  for n in "${novas[@]}"; do echo "  $n — $(descricao "$n")"; done
fi
echo "Pronto. Abra uma sessão nova do Claude Code para ele carregar as skills."
